# =========================================================================
# EXAMHUB INDIA — FIREBASE AUTHENTICATION CONFIGURATION
# =========================================================================
# How to get these values:
# 1. Open Google Firebase Console: https://console.firebase.google.com/
# 2. Select or create your project: "examhub-india"
# 3. Go to Project Settings (Gear icon) > General > Your apps > Web app (</>)
# 4. Copy the firebaseConfig keys and paste them below:
# 5. In Firebase Console > Authentication > Sign-in method:
#    Enable "Email/Password" provider.
# 6. In Firebase Console > Cloud Firestore:
#    Create database and apply rules from firestore.rules
# =========================================================================

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=examhub-india.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=examhub-india
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=examhub-india.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Backend URL (if running Python FastAPI backend locally)
BACKEND_URL=http://127.0.0.1:8000
