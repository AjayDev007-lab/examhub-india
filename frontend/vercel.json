{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/health-check",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 4 * * 0"
    }
  ]
}
