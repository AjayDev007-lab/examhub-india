# Firebase client configuration (copy values from Firebase Project settings)
NEXT_PUBLIC_AUTH_PROVIDER=firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Server-only Firebase Admin credentials for scheduled jobs (never NEXT_PUBLIC_)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=replace-with-service-account-private-key

# Server-only URL for the FastAPI Vercel project; do not prefix with NEXT_PUBLIC_
BACKEND_URL=https://your-examhub-api.vercel.app

# Server-only HS256 key used to verify API session cookies; must match backend SECRET_KEY
SECRET_KEY=replace-with-the-same-random-secret-used-by-the-backend

# First administrator account in the existing FastAPI database
SUPERADMIN_EMAIL=admin@your-production-domain.example

# Server-only Vercel cron authentication secret (use a unique random value)
CRON_SECRET=replace-with-a-separate-random-cron-secret

# Telegram sends this secret in X-Telegram-Bot-Api-Secret-Token on webhook updates
TELEGRAM_WEBHOOK_SECRET=replace-with-a-telegram-compatible-random-secret
