# EXAMHUB INDIA Configuration
APP_NAME="EXAMHUB INDIA"
APP_ENV=development
SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL 8, with an async driver)
# For local development, use: sqlite+aiosqlite:///./examhub_india.db
DATABASE_URL=mysql+aiomysql://examhub_user:URL_ENCODED_PASSWORD@db:3306/examhub_india

# Storage Path for Encrypted/Protected Student Documents and Hall Tickets
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0

# Admin account credentials (set unique values before production)
SUPERADMIN_EMAIL=admin@your-production-domain.example
SUPERADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters
FRONTEND_ORIGINS=["https://your-production-domain.example"]
BACKEND_URL=http://127.0.0.1:8000
SITE_HOSTNAME=your-production-domain.example
CRON_SECRET=replace-with-a-separate-random-cron-secret
PUBLIC_BASE_URL=https://your-production-domain.example
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=no-reply@your-production-domain.example
MYSQL_ROOT_PASSWORD=replace-with-a-unique-mysql-root-password
MYSQL_PASSWORD=replace-with-a-unique-mysql-password
