# EXAMHUB INDIA Configuration
APP_NAME="EXAMHUB INDIA"
APP_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (MySQL 8 or SQLite fallback for standalone testing)
# MySQL URL format: mysql+pymysql://user:password@localhost:3306/examhub_india
DATABASE_URL=sqlite+aiosqlite:///./examhub_india.db
SYNC_DATABASE_URL=sqlite:///./examhub_india.db

# Storage Path for Encrypted/Protected Student Documents and Hall Tickets
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15

# Redis / Celery (Optional for background workers)
REDIS_URL=redis://localhost:6379/0

# Admin Defaults (Seeded automatically on init)
SUPERADMIN_EMAIL=superadmin@examhub.gov.in
SUPERADMIN_PASSWORD=SuperAdmin@ExamHub2026!
