# ExamHub India — Firebase Configuration
# Copy this file to .env.local to connect to your live Firebase project

VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=examhub-india.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=examhub-india
VITE_FIREBASE_STORAGE_BUCKET=examhub-india.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Note: If no environment variables are provided, ExamHub India runs
# in Demo Mode with a fully functional, persistent localStore engine!
