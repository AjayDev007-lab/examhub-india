{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/job-discovery",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 3 * * *"
    }
  ]
}
